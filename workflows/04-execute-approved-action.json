    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE agent_runs\n  SET status = 'executing'\n  WHERE id = $1::bigint AND status = 'approved'\n  RETURNING id\n)\nSELECT c.id AS run_id, a.final_action\nFROM claimed c\nJOIN approvals a ON a.run_id = c.id AND a.state = 'approved'\nORDER BY a.id DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        400,
        80
      ],
      "id": "f6dab695-286f-4452-a1df-fe0165602ea7",
      "name": "Claim Run",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "MhZHDzAy64LfOvDJ",
          "name": "InboxOps Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "0c57c274-370d-4c4f-9075-b140244e92d2",
              "leftValue": "={{ $json.run_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
