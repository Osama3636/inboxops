    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT a.id AS approval_id\n  FROM approvals a\n  WHERE a.run_id = $1\n    AND a.state = 'pending'\n    AND a.expires_at > now()\n    AND $2::text IN ('approved', 'rejected')\n  ORDER BY a.id DESC\n  LIMIT 1\n),\nupd_approval AS (\n  UPDATE approvals\n  SET state = $2::text,\n      approver = $3::text,\n      decided_at = now(),\n      final_action = CASE\n        WHEN $2::text = 'approved' THEN (SELECT proposed_action FROM agent_runs WHERE id = $1)\n        ELSE NULL\n      END\n  WHERE id = (SELECT approval_id FROM target)\n  RETURNING run_id\n)\nUPDATE agent_runs\nSET status = $2::text\nWHERE id IN (SELECT run_id FROM upd_approval)\n  AND status = 'awaiting_approval'\nRETURNING id, status;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id, $json.decision, $json.approver ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
