    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Shape Error: keeps only short, safe fields from the error report.\n// Error messages can contain email text, so everything is cut short.\nconst d = $json;\nconst ex = d.execution || {};\nconst wf = d.workflow || {};\nconst err = ex.error || {};\nreturn {\n  json: {\n    workflow_name: String(wf.name ?? '').slice(0, 200),\n    workflow_id: String(wf.id ?? '').slice(0, 100),\n    execution_id: String(ex.id ?? '').slice(0, 100),\n    node_name: String(ex.lastNodeExecuted ?? '').slice(0, 200),\n    error_message: String(err.message ?? '').slice(0, 1000),\n    raw_json: JSON.stringify({ mode: ex.mode ?? null, url: ex.url ?? null })\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "4aa8421f-2f84-4f0f-9cdf-81b31dc94230",
      "name": "Shape Error"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (workflow_name, workflow_id, execution_id, node_name, error_message, raw)\nVALUES ($1, $2, $3, $4, $5, $6::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.workflow_name, $json.workflow_id, $json.execution_id, $json.node_name, $json.error_message, $json.raw_json ] }}"
