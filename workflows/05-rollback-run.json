    {
      "parameters": {
        "jsCode": "// Plan Rollback: turns the stored list of created records into archive calls.\nconst SUPPORTED = ['crm.lead'];\n\nconst row = $input.first().json;\nconst records = row.odoo_records;\n\nif (!Array.isArray(records) || records.length !== 1) {\n  throw new Error('Rollback expects exactly one created record for this run');\n}\n\nreturn records.map(rec => {\n  if (!SUPPORTED.includes(rec.model)) {\n    throw new Error('Rollback is not supported yet for ' + rec.model);\n  }\n  if (!Number.isInteger(rec.id) || rec.id <= 0) {\n    throw new Error('Invalid record id in the run');\n  }\n  return {\n    json: {\n      run_id: String(row.run_id),\n      model: rec.model,\n      id: rec.id,\n      body: { ids: [rec.id], vals: { active: false } }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "4275904a-c960-4a28-bd9c-ecf4e5acacb1",
      "name": "Plan Rollback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_BASE_URL }}/json/2/{{ $json.model }}/write",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Odoo-Database",
              "value": "={{ $env.ODOO_DB_NAME }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1104,
        0
      ],
      "id": "93b1ea0e-4de3-4300-98ac-505309a56bbc",
      "name": "Odoo Archive",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpBearerAuth": {
          "id": "hrUVqAONw9zLBmqb",
          "name": "InboxOps Odoo (Bearer)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prepare Rolled Back: checks that Odoo confirmed the archive.\nconst step = $('Plan Rollback').item.json;\nlet result;\ntry {\n  result = JSON.parse($json.data);\n} catch (e) {\n  throw new Error('Odoo answer was not valid JSON');\n}\nif (result !== true) {\n  throw new Error('Odoo did not confirm the archive');\n}\nreturn { json: { run_id: step.run_id } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        -112
      ],
      "id": "54376933-8e2c-4107-96df-418daa2a917e",
      "name": "Prepare Rolled Back"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agent_runs\nSET status = 'rolled_back', error_message = NULL\nWHERE id = $1::bigint AND status = 'executed'\nRETURNING id, status;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1552,
        -112
      ],
      "id": "f29ee95f-adee-4176-bbe6-8c84ab6fcf10",
      "name": "Mark Rolled Back",
      "credentials": {
        "postgres": {
          "id": "MhZHDzAy64LfOvDJ",
          "name": "InboxOps Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prepare Rollback Failure: records why the rollback did not complete.\nconst step = $('Plan Rollback').item.json;\nconst e = $json.error;\nconst msg = typeof e === 'string' ? e : (e && e.message ? e.message : JSON.stringify(e || $json));\nreturn {\n  json: {\n    run_id: step.run_id,\n    error_message: ('Rollback incomplete: ' + msg).slice(0, 500)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        64
      ],
      "id": "e89c780d-ffd4-4b68-b34f-21d03e535404",
      "name": "Prepare Rollback Failure"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agent_runs\nSET error_message = $2\nWHERE id = $1::bigint AND status = 'executed'\nRETURNING id, status, error_message;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id, $json.error_message ] }}"
        }
