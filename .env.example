# ===== Pinned versions =====
N8N_VERSION=2.41.6
ODOO_VERSION=19.0

# ===== n8n core =====
# Generate a random 64-character key and paste it here BEFORE first start
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# IANA timezone name
TZ=Africa/Cairo

# ===== Postgres: n8n container =====
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_me_letters_and_digits_only
INBOXOPS_DB_NAME=inboxops
INBOXOPS_DB_USER=inboxops_app
INBOXOPS_DB_PASSWORD=change_me_letters_and_digits_only

# ===== Postgres: Odoo container =====
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change_me_letters_and_digits_only
# The Odoo database you will create in the Odoo web UI later
ODOO_DB_NAME=odoo_inboxops

# ===== LLM config. Change these lines to swap providers =====
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# These are placeholders: update them from the provider's current price list.
LLM_PRICE_INPUT_PER_1M=0.30
LLM_PRICE_OUTPUT_PER_1M=2.50

# ===== App behaviour =====
CONFIDENCE_THRESHOLD=0.7
MAX_EMAIL_CHARS=6000
APPROVAL_TIMEOUT_HOURS=24